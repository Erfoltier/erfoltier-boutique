---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { site } from '../../data/site';
import { type Lang, type UIKey, langPaths, useTranslations } from '../../i18n/ui';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

/*
 * フォームの送信先。Formspree などのフォームサービスのURLを設定すると実際に送信されます。
 * 空のままの場合は送信せず、完了メッセージのみ表示します（デモ動作）。
 */
const FORM_ENDPOINT = '';

const types = ['product', 'order', 'other'] as const;
const company: [UIKey, string][] = [
  ['company.name', site.company.name[lang]],
  ['company.rep', site.company.rep[lang]],
  ['company.address', site.company.address[lang]],
  ['company.email', site.email],
  ['company.hours', t('company.hoursValue')],
  ['company.business', t('company.businessValue')],
  ['company.license', site.company.license[lang]],
];
const Req = t('contact.required');
---

<Base lang={lang} title={t('contact.title')} path="contact/">
  <div class="container narrow">
    <PageHead lang={lang} eyebrow="Contact" title={t('contact.title')} lead={t('contact.lead')} crumbs={[{ label: t('contact.title') }]} />

    <form class="form" method="post" action={FORM_ENDPOINT || undefined} data-contact-form data-endpoint={FORM_ENDPOINT}>
      {
        lang === 'ja' && (
          <>
            <fieldset class="field">
              <legend class="label">{t('contact.name')}<span class="req">{Req}</span></legend>
              <div class="row2">
                <input class="input" name="last_name" autocomplete="family-name" placeholder={`${t('contact.lastName')}（例：山田）`} aria-label={t('contact.lastName')} required />
                <input class="input" name="first_name" autocomplete="given-name" placeholder={`${t('contact.firstName')}（例：花子）`} aria-label={t('contact.firstName')} required />
              </div>
            </fieldset>
            <fieldset class="field">
              <legend class="label">{t('contact.nameKana')}<span class="req">{Req}</span></legend>
              <div class="row2">
                <input class="input" name="last_name_kana" placeholder={`${t('contact.lastNameKana')}（例：ヤマダ）`} aria-label={t('contact.lastNameKana')} pattern="[ァ-ヶー　 ]+" title="全角カタカナで入力してください" required />
                <input class="input" name="first_name_kana" placeholder={`${t('contact.firstNameKana')}（例：ハナコ）`} aria-label={t('contact.firstNameKana')} pattern="[ァ-ヶー　 ]+" title="全角カタカナで入力してください" required />
              </div>
            </fieldset>
          </>
        )
      }
      {
        lang === 'en' && (
          <fieldset class="field">
            <legend class="label">{t('contact.name')}<span class="req">{Req}</span></legend>
            <div class="row2">
              <input class="input" name="first_name" autocomplete="given-name" placeholder={t('contact.firstName')} aria-label={t('contact.firstName')} required />
              <input class="input" name="last_name" autocomplete="family-name" placeholder={t('contact.lastName')} aria-label={t('contact.lastName')} required />
            </div>
          </fieldset>
        )
      }
      {
        lang === 'ko' && (
          <div class="field">
            <label for="f-name">{t('contact.name')}<span class="req">{Req}</span></label>
            <input class="input" id="f-name" name="name" autocomplete="name" required />
          </div>
        )
      }

      <div class="row2">
        <div class="field">
          <label for="f-email">{t('contact.email')}<span class="req">{Req}</span></label>
          <input class="input" id="f-email" type="email" name="email" autocomplete="email" inputmode="email" required />
        </div>
        <div class="field">
          <label for="f-tel">{t('contact.phone')}</label>
          <input class="input" id="f-tel" type="tel" name="phone" autocomplete="tel" inputmode="tel" />
        </div>
      </div>

      <div class="row2">
        <div class="field">
          <label for="f-type">{t('contact.type')}<span class="req">{Req}</span></label>
          <select class="select" id="f-type" name="type" required>
            {types.map((ty) => <option value={ty}>{t(`contact.type.${ty}` as UIKey)}</option>)}
          </select>
        </div>
        <div class="field">
          <label for="f-ref">{t('contact.productRef')}</label>
          <input class="input" id="f-ref" name="ref" placeholder="EF-24001" />
        </div>
      </div>

      <div class="field">
        <label for="f-msg">{t('contact.message')}<span class="req">{Req}</span></label>
        <textarea class="textarea" id="f-msg" name="message" required></textarea>
      </div>

      <label class="check">
        <input type="checkbox" name="privacy" required />
        <span>{t('contact.privacy')}</span>
        <span class="req">{Req}</span>
      </label>

      <input type="hidden" name="lang" value={lang} />
      <button class="btn submit" type="submit">{t('contact.submit')}</button>
      <p class="thanks" role="status" data-thanks hidden>{t('contact.thanks')}</p>
    </form>

    <section id="company" class="company">
      <p class="eyebrow">Company</p>
      <h2>{t('company.title')}</h2>
      <dl>
        {
          company.map(([k, v]) => (
            <div>
              <dt>{t(k)}</dt>
              <dd>{k === 'company.email' ? <a href={`mailto:${v}`}>{v}</a> : v}</dd>
            </div>
          ))
        }
        <div>
          <dt>Instagram</dt>
          <dd><a href={site.instagram} target="_blank" rel="noopener">{site.instagramHandle}</a></dd>
        </div>
      </dl>
    </section>
  </div>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]')!;
  const params = new URLSearchParams(location.search);
  const ref = params.get('ref');
  const type = params.get('type');
  if (ref) (form.elements.namedItem('ref') as HTMLInputElement).value = ref;
  if (type) (form.elements.namedItem('type') as HTMLSelectElement).value = type;

  form.addEventListener('submit', async (e) => {
    const endpoint = form.dataset.endpoint;
    e.preventDefault();
    const thanks = form.querySelector<HTMLElement>('[data-thanks]')!;
    const submit = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    submit.disabled = true;
    try {
      if (endpoint) {
        const res = await fetch(endpoint, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
        if (!res.ok) throw new Error(String(res.status));
      }
      form.reset();
      thanks.hidden = false;
      thanks.scrollIntoView({ behavior: 'smooth', block: 'center' });
    } catch {
      submit.disabled = false;
      alert('Error. Please try again later.');
    }
  });
</script>

<style>
  .narrow {
    max-width: 880px;
  }
  .form {
    display: grid;
    gap: 28px;
  }
  fieldset.field {
    border: 0;
    margin: 0;
    padding: 0;
    min-width: 0;
  }
  fieldset.field legend {
    padding: 0;
    margin-bottom: 8px;
  }
  .row2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px 24px;
  }
  @media (max-width: 600px) {
    .row2 {
      grid-template-columns: 1fr;
    }
    fieldset .row2 {
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }
  }
  .check {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 14px;
    cursor: pointer;
  }
  .check input {
    width: 18px;
    height: 18px;
    accent-color: var(--ink);
  }
  .submit {
    justify-self: center;
    min-width: 280px;
    margin-top: 12px;
  }
  .thanks {
    padding: 24px;
    border: 1px solid var(--gold);
    background: var(--paper);
    text-align: center;
  }
  .company {
    margin-top: clamp(80px, 10vw, 120px);
    padding-top: clamp(48px, 6vw, 72px);
    border-top: 1px solid var(--line);
  }
  .company h2 {
    margin-top: 10px;
    font-size: clamp(22px, 2.6vw, 30px);
    letter-spacing: 0.1em;
  }
  .company dl {
    margin: 32px 0 0;
    border-top: 1px solid var(--ink);
    font-size: 14px;
  }
  .company dl div {
    display: grid;
    grid-template-columns: 11em 1fr;
    gap: 16px;
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
  }
  .company dt {
    color: var(--muted);
  }
  .company dd {
    margin: 0;
  }
  .company a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  @media (max-width: 600px) {
    .company dl div {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
</style>
