---
import type { Product } from '../data/catalog';
import { getBrand, isNew } from '../data/catalog';
import { type Lang, type UIKey, formatPrice, href, useTranslations } from '../i18n/ui';
import ProductImage from './ProductImage.astro';

interface Props {
  product: Product;
  lang: Lang;
}

const { product: p, lang } = Astro.props;
const t = useTranslations(lang);
const brand = getBrand(p.brand);
---

<article
  class="card"
  data-product
  data-brand={p.brand}
  data-category={p.category}
  data-sub={p.sub}
  data-price={p.price}
  data-type={isNew(p) ? 'new' : 'used'}
  data-arrived={p.arrived}
>
  <a href={href(lang, `products/${p.id.toLowerCase()}/`)} class="card__link">
    <div class="card__media">
      <ProductImage category={p.category} variant={p.sub} label={brand.name} image={p.image} alt={`${brand.name} ${p.name[lang]}`} seed={p.id} />
      {p.sold && <span class="card__sold">{t('product.sold')}</span>}
    </div>
    <div class="card__body">
      <p class="card__brand">{brand.name}</p>
      <h3 class="card__name">{p.name[lang]}</h3>
      <div class="card__meta">
        <span class="card__price">{formatPrice(p.price, lang)}<small>{t('product.taxIncluded')}</small></span>
        {
          isNew(p) ? (
            <span class="tag-new">{t('type.new')}</span>
          ) : (
            <span class="rank" title={`${t('type.used')}：${t(`condition.${p.condition}` as UIKey)}`}>{p.condition}</span>
          )
        }
      </div>
    </div>
  </a>
</article>

<style>
  .card__link {
    display: block;
  }
  .card__media {
    position: relative;
    overflow: hidden;
  }
  .card__link:hover :global(.pimg :is(img, svg)) {
    transform: scale(1.04);
  }
  .card__sold {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: rgba(251, 251, 251, 0.6);
    backdrop-filter: blur(3px);
    font-family: var(--font-display);
    letter-spacing: 0.3em;
    font-size: 15px;
  }
  .card__body {
    padding-top: 16px;
  }
  .card__brand {
    font-family: var(--font-display);
    font-size: 14px;
    letter-spacing: 0.18em;
    line-height: 1.3;
  }
  .card__name {
    margin-top: 4px;
    font-family: var(--font-sans);
    font-size: 13px;
    line-height: 1.7;
    color: var(--ink-2);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-top: 10px;
  }
  .card__price {
    font-size: 14px;
    letter-spacing: 0.04em;
    font-feature-settings: 'tnum';
  }
  .card__price small {
    white-space: nowrap;
    margin-left: 4px;
    font-size: 10px;
    color: var(--muted);
  }
</style>
