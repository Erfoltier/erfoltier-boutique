---
import type { CategorySlug, SubSlug } from '../data/catalog';

interface Props {
  category: CategorySlug;
  /** 「その他」のアイテム種別。線画の絵柄を切り替える */
  variant?: SubSlug;
  label: string;
  image?: string;
  alt: string;
  seed?: string;
  eager?: boolean;
}

const { category, variant, label, image, alt, seed = label, eager = false } = Astro.props;
const art = category === 'other' ? (variant ?? 'eyewear') : category;

// 写真が未登録の間は、カテゴリーごとの線画で上品なプレースホルダーを描画する
const tones = [
  ['#f7f7f7', '#e7e8e9'],
  ['#f5f5f5', '#e4e5e6'],
  ['#f8f8f8', '#eaebeb'],
  ['#f3f3f3', '#e2e3e4'],
  ['#f6f6f6', '#e6e7e8'],
];
let h = 0;
for (const c of seed) h = (h * 31 + c.charCodeAt(0)) >>> 0;
const [from, to] = tones[h % tones.length];
const gid = `g-${h.toString(36)}`;
---

<div class="pimg">
  {
    image ? (
      <img src={image} alt={alt} loading={eager ? 'eager' : 'lazy'} decoding="async" width="800" height="1000" />
    ) : (
      <svg viewBox="0 0 400 500" role="img" aria-label={alt} preserveAspectRatio="xMidYMid slice">
        <defs>
          <linearGradient id={gid} x1="0" y1="0" x2="0.6" y2="1">
            <stop offset="0" stop-color={from} />
            <stop offset="1" stop-color={to} />
          </linearGradient>
          <radialGradient id={`${gid}-l`} cx="0.42" cy="0.32" r="0.62">
            <stop offset="0" stop-color="#fff" stop-opacity="0.75" />
            <stop offset="1" stop-color="#fff" stop-opacity="0" />
          </radialGradient>
        </defs>
        <rect width="400" height="500" fill={`url(#${gid})`} />
        <rect width="400" height="500" fill={`url(#${gid}-l)`} />
        <g fill="none" stroke="#a9a8a4" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round">
          {art === 'leather' && (
            <>
              <path d="M150 190 C150 138 250 138 250 190" />
              <path d="M162 190 C162 150 238 150 238 190" />
              <path d="M112 200 H288 L300 370 H100 Z" />
              <path d="M112 200 L200 262 L288 200" />
              <rect x="190" y="255" width="20" height="16" rx="2" />
            </>
          )}
          {art === 'watches' && (
            <>
              <path d="M178 110 H222 L228 196 M172 196 L178 110" />
              <path d="M178 304 L172 390 H228 L222 304" />
              <circle cx="200" cy="250" r="58" />
              <circle cx="200" cy="250" r="48" />
              <path d="M200 250 V214 M200 250 L226 262" />
              <path d="M258 244 h8 v12 h-8" />
              <path d="M200 206 v4 M200 290 v4 M156 250 h4 M240 250 h4" />
            </>
          )}
          {art === 'accessories' && (
            <>
              <ellipse cx="200" cy="286" rx="84" ry="84" />
              <ellipse cx="200" cy="286" rx="72" ry="72" />
              <path d="M178 196 L200 170 L222 196 L200 214 Z" />
              <path d="M178 196 H222 M200 170 L192 196 L200 214 L208 196 Z" />
            </>
          )}
          {art === 'fabric' && (
            <>
              <path d="M150 214 C150 130 176 118 176 214 M224 214 C224 118 250 130 250 214" />
              <path d="M116 214 H284 L270 372 H130 Z" />
              <path d="M124 244 H276" opacity="0.5" />
              <path d="M150 214 v30 M250 214 v30" opacity="0.5" />
            </>
          )}
          {art === 'scarf' && (
            <>
              <path d="M200 130 L318 248 L200 366 L82 248 Z" />
              <path d="M200 156 L292 248 L200 340 L108 248 Z" />
              <path d="M200 196 L252 248 L200 300 L148 248 Z" />
              <path d="M318 248 C332 290 316 330 300 360 M82 248 C68 290 84 330 100 360" />
            </>
          )}
          {art === 'eyewear' && (
            <>
              <path d="M96 236 H304" />
              <path d="M104 236 C100 290 122 312 156 312 C188 312 196 286 194 250 L192 236" />
              <path d="M296 236 C300 290 278 312 244 312 C212 312 204 286 206 250 L208 236" />
              <path d="M194 250 C198 244 202 244 206 250" />
              <path d="M96 236 L76 212 M304 236 L324 212" />
              <path d="M130 258 L150 250 M232 258 L252 250" opacity="0.5" />
            </>
          )}
          {art === 'charm' && (
            <>
              <circle cx="200" cy="150" r="20" />
              <path d="M200 170 V206" stroke-dasharray="3 5" />
              <circle cx="200" cy="232" r="24" />
              <circle cx="200" cy="296" r="24" />
              <circle cx="168" cy="264" r="24" />
              <circle cx="232" cy="264" r="24" />
              <circle cx="200" cy="264" r="9" />
            </>
          )}
          {art === 'hat' && (
            <>
              <ellipse cx="200" cy="306" rx="124" ry="26" />
              <path d="M128 300 C132 222 152 196 200 196 C248 196 268 222 272 300" />
              <path d="M132 272 C170 284 230 284 268 272" />
              <path d="M132 260 C170 272 230 272 268 260" opacity="0.5" />
            </>
          )}
          {art === 'tie' && (
            <>
              <path d="M184 128 H216 L208 158 H192 Z" />
              <path d="M192 158 L172 332 L200 368 L228 332 L208 158" />
              <path d="M186 214 L214 196 M182 252 L218 228 M178 290 L222 262 M180 326 L224 298" opacity="0.55" />
              <path d="M160 118 L184 128 M240 118 L216 128" />
            </>
          )}
          {art === 'kitchen' && (
            <>
              <ellipse cx="200" cy="330" rx="112" ry="18" />
              <ellipse cx="200" cy="330" rx="70" ry="10" opacity="0.5" />
              <path d="M136 226 H264 C262 296 236 318 200 318 C164 318 138 296 136 226 Z" />
              <path d="M262 246 C302 246 302 292 252 296" />
              <path d="M180 200 C170 186 190 178 180 160 M204 200 C194 186 214 178 204 160 M228 200 C218 186 238 178 228 160" opacity="0.55" />
            </>
          )}
          {art === 'cushion' && (
            <>
              <path d="M112 172 Q200 192 288 172 Q268 252 288 332 Q200 312 112 332 Q132 252 112 172 Z" />
              <path d="M130 188 Q200 204 270 188 Q254 252 270 316 Q200 300 130 316 Q146 252 130 188 Z" opacity="0.5" />
              <circle cx="200" cy="252" r="5" />
              <path d="M112 172 l-10 -10 M288 172 l10 -10 M112 332 l-10 10 M288 332 l10 10" />
            </>
          )}
          {art === 'linen' && (
            <>
              <rect x="108" y="200" width="184" height="42" rx="10" />
              <rect x="116" y="242" width="176" height="42" rx="10" />
              <rect x="108" y="284" width="184" height="42" rx="10" />
              <path d="M150 200 V242 M158 242 V284 M150 284 V326" opacity="0.45" />
              <path d="M124 326 v12 M140 326 v12 M156 326 v12 M172 326 v12 M188 326 v12 M204 326 v12 M220 326 v12 M236 326 v12 M252 326 v12 M268 326 v12 M284 326 v12" opacity="0.6" />
            </>
          )}
          {art === 'apparel' && (
            <>
              <path d="M200 112 a10 10 0 1 1 10 10 v10" />
              <path d="M130 158 L200 134 L270 158" />
              <path d="M130 158 L96 196 L112 300 L136 296 L138 212 L140 380 H260 L262 212 L264 296 L288 300 L304 196 L270 158" />
              <path d="M178 144 L200 240 L222 144" />
              <path d="M200 240 V380" />
              <circle cx="212" cy="270" r="3" />
              <circle cx="212" cy="310" r="3" />
            </>
          )}
        </g>
        <text x="200" y="448" text-anchor="middle" fill="#9d9fa3" font-family="'Cormorant Garamond', serif" font-size="17" letter-spacing="5">
          {label}
        </text>
      </svg>
    )
  }
</div>

<style>
  .pimg {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: #f0f0f0;
  }
  .pimg :is(img, svg) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s var(--ease);
  }
</style>
