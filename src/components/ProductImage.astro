---
import type { CategorySlug } from '../data/catalog';

interface Props {
  category: CategorySlug;
  label: string;
  image?: string;
  alt: string;
  seed?: string;
  eager?: boolean;
}

const { category, label, image, alt, seed = label, eager = false } = Astro.props;

// 写真が未登録の間は、カテゴリーごとの線画で上品なプレースホルダーを描画する
const tones = [
  ['#ebe7e1', '#d9d2c8'],
  ['#e8e4de', '#d3cbc0'],
  ['#eeebe6', '#dcd6cd'],
  ['#e6e1da', '#cfc6ba'],
  ['#ece9e4', '#d6d0c7'],
];
let h = 0;
for (const c of seed) h = (h * 31 + c.charCodeAt(0)) >>> 0;
const [from, to] = tones[h % tones.length];
const gid = `g-${h.toString(36)}`;
---

<div class="pimg">
  {
    image ? (
      <img src={image} alt={alt} loading={eager ? 'eager' : 'lazy'} decoding="async" width="800" height="1000" />
    ) : (
      <svg viewBox="0 0 400 500" role="img" aria-label={alt} preserveAspectRatio="xMidYMid slice">
        <defs>
          <linearGradient id={gid} x1="0" y1="0" x2="0.6" y2="1">
            <stop offset="0" stop-color={from} />
            <stop offset="1" stop-color={to} />
          </linearGradient>
        </defs>
        <rect width="400" height="500" fill={`url(#${gid})`} />
        <ellipse cx="200" cy="378" rx="104" ry="10" fill="#16140f" opacity="0.06" />
        <g fill="none" stroke="#a8844a" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          {category === 'leather' && (
            <>
              <path d="M150 190 C150 138 250 138 250 190" />
              <path d="M162 190 C162 150 238 150 238 190" />
              <path d="M112 200 H288 L300 370 H100 Z" />
              <path d="M112 200 L200 262 L288 200" />
              <rect x="190" y="255" width="20" height="16" rx="2" />
            </>
          )}
          {category === 'watches' && (
            <>
              <path d="M178 110 H222 L228 196 M172 196 L178 110" />
              <path d="M178 304 L172 390 H228 L222 304" />
              <circle cx="200" cy="250" r="58" />
              <circle cx="200" cy="250" r="48" />
              <path d="M200 250 V214 M200 250 L226 262" />
              <path d="M258 244 h8 v12 h-8" />
              <path d="M200 206 v4 M200 290 v4 M156 250 h4 M240 250 h4" />
            </>
          )}
          {category === 'accessories' && (
            <>
              <ellipse cx="200" cy="286" rx="84" ry="84" />
              <ellipse cx="200" cy="286" rx="72" ry="72" />
              <path d="M178 196 L200 170 L222 196 L200 214 Z" />
              <path d="M178 196 H222 M200 170 L192 196 L200 214 L208 196 Z" />
            </>
          )}
          {category === 'fabric' && (
            <>
              <path d="M200 130 L318 248 L200 366 L82 248 Z" />
              <path d="M200 156 L292 248 L200 340 L108 248 Z" />
              <path d="M200 196 L252 248 L200 300 L148 248 Z" />
              <path d="M318 248 C332 290 316 330 300 360 M82 248 C68 290 84 330 100 360" />
            </>
          )}
          {category === 'other' && (
            <>
              <path d="M96 236 H304" />
              <path d="M104 236 C100 290 122 312 156 312 C188 312 196 286 194 250 L192 236" />
              <path d="M296 236 C300 290 278 312 244 312 C212 312 204 286 206 250 L208 236" />
              <path d="M194 250 C198 244 202 244 206 250" />
              <path d="M96 236 L76 212 M304 236 L324 212" />
              <path d="M130 258 L150 250 M232 258 L252 250" opacity="0.5" />
            </>
          )}
          {category === 'apparel' && (
            <>
              <path d="M200 112 a10 10 0 1 1 10 10 v10" />
              <path d="M130 158 L200 134 L270 158" />
              <path d="M130 158 L96 196 L112 300 L136 296 L138 212 L140 380 H260 L262 212 L264 296 L288 300 L304 196 L270 158" />
              <path d="M178 144 L200 240 L222 144" />
              <path d="M200 240 V380" />
              <circle cx="212" cy="270" r="3" />
              <circle cx="212" cy="310" r="3" />
            </>
          )}
        </g>
        <text x="200" y="448" text-anchor="middle" fill="#7a7366" font-family="'Cormorant Garamond', serif" font-size="17" letter-spacing="5">
          {label}
        </text>
      </svg>
    )
  }
</div>

<style>
  .pimg {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: #e8e4de;
  }
  .pimg :is(img, svg) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s var(--ease);
  }
</style>
