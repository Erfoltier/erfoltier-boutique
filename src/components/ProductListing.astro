---
import type { Product } from '../data/catalog';
import { brands, categories, subCategories, byNewest } from '../data/catalog';
import { type Lang, useTranslations } from '../i18n/ui';
import ProductCard from './ProductCard.astro';

interface Props {
  lang: Lang;
  items: Product[];
  showCategory?: boolean;
  showBrand?: boolean;
  showSub?: boolean;
}

const { lang, items, showCategory = true, showBrand = true, showSub = false } = Astro.props;
const t = useTranslations(lang);
const sorted = [...items].sort(byNewest);
const usedBrands = brands.filter((b) => items.some((p) => p.brand === b.slug));
const usedSubs = subCategories.filter((c) => items.some((p) => p.sub === c.slug));
const usedCats = categories.filter((c) => items.some((p) => p.category === c.slug));
const countLabel = t('products.count', { n: '{n}' });
---

<div class="listing" data-listing data-count-label={countLabel}>
  <div class="toolbar">
    {
      showCategory && (
        <div class="chips" role="group" aria-label={t('filter.category')}>
          <button type="button" class="chip" data-filter-cat="" aria-pressed="true">{t('filter.all')}</button>
          {usedCats.map((c) => (
            <button type="button" class="chip" data-filter-cat={c.slug} aria-pressed="false">
              {c.name[lang]}
            </button>
          ))}
        </div>
      )
    }
    {
      showSub && (
        <div class="chips" role="group" aria-label={t('filter.item')}>
          <button type="button" class="chip" data-filter-sub="" aria-pressed="true">{t('filter.all')}</button>
          {usedSubs.map((c) => (
            <button type="button" class="chip" data-filter-sub={c.slug} aria-pressed="false">
              {c.name[lang]}
            </button>
          ))}
        </div>
      )
    }
    <div class="chips chips--type" role="group" aria-label={t('type.filter')}>
      <button type="button" class="chip" data-filter-type="" aria-pressed="true">{t('filter.all')}</button>
      <button type="button" class="chip" data-filter-type="new" aria-pressed="false">{t('type.new')}</button>
      <button type="button" class="chip" data-filter-type="used" aria-pressed="false">{t('type.used')}</button>
    </div>
    <div class="toolbar__right">
      <p class="toolbar__count" aria-live="polite" data-count>{t('products.count', { n: items.length })}</p>
      {
        showBrand && (
          <label class="toolbar__select">
            <span class="visually-hidden">{t('filter.brand')}</span>
            <select class="select" data-filter-brand>
              <option value="">{t('filter.brand')}：{t('filter.all')}</option>
              {usedBrands.map((b) => <option value={b.slug}>{b.name}</option>)}
            </select>
          </label>
        )
      }
      <label class="toolbar__select">
        <span class="visually-hidden">{t('filter.sort')}</span>
        <select class="select" data-sort>
          <option value="new">{t('sort.new')}</option>
          <option value="priceAsc">{t('sort.priceAsc')}</option>
          <option value="priceDesc">{t('sort.priceDesc')}</option>
        </select>
      </label>
    </div>
  </div>

  <div class="product-grid" data-grid>
    {sorted.map((p) => <ProductCard product={p} lang={lang} />)}
  </div>
  <p class="empty" data-empty hidden>{t('products.empty')}</p>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-listing]').forEach((root) => {
    const grid = root.querySelector<HTMLElement>('[data-grid]')!;
    const cards = [...grid.querySelectorAll<HTMLElement>('[data-product]')];
    const chips = [...root.querySelectorAll<HTMLButtonElement>('[data-filter-cat]')];
    const subChips = [...root.querySelectorAll<HTMLButtonElement>('[data-filter-sub]')];
    const typeChips = [...root.querySelectorAll<HTMLButtonElement>('[data-filter-type]')];
    const brandSel = root.querySelector<HTMLSelectElement>('[data-filter-brand]');
    const sortSel = root.querySelector<HTMLSelectElement>('[data-sort]')!;
    const countEl = root.querySelector<HTMLElement>('[data-count]')!;
    const emptyEl = root.querySelector<HTMLElement>('[data-empty]')!;
    const label = root.dataset.countLabel!;

    const params = new URLSearchParams(location.search);
    let cat = params.get('category') ?? '';
    let type = params.get('type') ?? '';
    let subSel = params.get('item') ?? '';
    if (brandSel) brandSel.value = params.get('brand') ?? '';
    sortSel.value = params.get('sort') ?? 'new';
    if (!sortSel.value) sortSel.value = 'new';

    function apply() {
      const brand = brandSel?.value ?? '';
      const sort = sortSel.value;
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.filterCat === cat)));
      subChips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.filterSub === subSel)));
      typeChips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.filterType === type)));

      const sorted = [...cards].sort((a, b) => {
        if (sort === 'priceAsc') return Number(a.dataset.price) - Number(b.dataset.price);
        if (sort === 'priceDesc') return Number(b.dataset.price) - Number(a.dataset.price);
        return b.dataset.arrived!.localeCompare(a.dataset.arrived!);
      });
      let visible = 0;
      for (const card of sorted) {
        const show =
          (!cat || card.dataset.category === cat) && (!brand || card.dataset.brand === brand) && (!type || card.dataset.type === type) && (!subSel || card.dataset.sub === subSel);
        card.hidden = !show;
        if (show) visible++;
        grid.appendChild(card);
      }
      countEl.textContent = label.replace('{n}', String(visible));
      emptyEl.hidden = visible > 0;

      const q = new URLSearchParams();
      if (cat) q.set('category', cat);
      if (type) q.set('type', type);
      if (subSel) q.set('item', subSel);
      if (brand) q.set('brand', brand);
      if (sort !== 'new') q.set('sort', sort);
      const qs = q.toString();
      history.replaceState(null, '', qs ? `?${qs}` : location.pathname);
    }

    chips.forEach((c) =>
      c.addEventListener('click', () => {
        cat = c.dataset.filterCat ?? '';
        apply();
      }),
    );
    subChips.forEach((c) =>
      c.addEventListener('click', () => {
        subSel = c.dataset.filterSub ?? '';
        apply();
      }),
    );
    typeChips.forEach((c) =>
      c.addEventListener('click', () => {
        type = c.dataset.filterType ?? '';
        apply();
      }),
    );
    brandSel?.addEventListener('change', apply);
    sortSel.addEventListener('change', apply);
    apply();
  });
</script>

<style>
  .toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 24px;
    margin-bottom: clamp(28px, 4vw, 44px);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .chip {
    min-height: 38px;
    padding: 0 18px;
    border: 1px solid var(--line);
    background: transparent;
    font-size: 12.5px;
    letter-spacing: 0.1em;
    cursor: pointer;
    transition: all 0.25s var(--ease);
  }
  .chip:hover {
    border-color: var(--ink);
  }
  .chip[aria-pressed='true'] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }
  .toolbar__right {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-left: auto;
  }
  .toolbar__count {
    font-size: 12px;
    color: var(--muted);
    letter-spacing: 0.1em;
    margin-right: 8px;
  }
  .toolbar__select .select {
    min-height: 42px;
    width: auto;
    padding-block: 8px;
  }
  @media (min-width: 768px) {
    .toolbar__select .select {
      font-size: 13px;
    }
  }
  .empty {
    padding: 64px 0;
    text-align: center;
    color: var(--muted);
  }
  [data-product][hidden] {
    display: none;
  }
</style>
